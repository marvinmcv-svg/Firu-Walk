# ── FiruWalk environment ────────────────────────────────────────────
# Copy to .env and fill in. Validated at boot by src/lib/server/env.ts.
# Empty values count as "not set".

# PostgreSQL (required). Local: `docker compose up -d db`.
DATABASE_URL="postgresql://firu:firu@localhost:5432/firuwalk?schema=public"
# Non-pooled URL used only by `prisma migrate` (Supabase/Neon direct connection).
# Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://firu:firu@localhost:5432/firuwalk?schema=public"

# Redis (optional until Milestone 2). Local: `docker compose up -d redis`.
REDIS_URL=""

# Public base URL of the app.
APP_URL="http://localhost:3000"

# HMAC key for session tokens and login codes, ≥32 chars. REQUIRED in production.
# Generate: openssl rand -base64 48
SESSION_SECRET=""

# Demo mode: one-click demo accounts + fixed login code (config.demo.otpCode).
# Refused on Vercel production deployments. Handy locally and on previews.
DEMO_MODE="true"

# Realtime live-service (mini-services/live-service). The app signs socket
# tokens with REALTIME_SECRET and publishes chat/walk events to the service's
# internal port. Same REALTIME_SECRET must be set on the live-service.
# REQUIRED in production when LIVE_SERVICE_INTERNAL_URL is set. ≥32 chars.
REALTIME_SECRET=""
LIVE_SERVICE_INTERNAL_URL="http://localhost:3004"
# Public socket URL when the live-service is on another host (production).
# Empty = same origin through the dev gateway (/?XTransformPort=3003).
NEXT_PUBLIC_LIVE_URL=""

# Walker GPS simulator (development / e2e only): instead of the device GPS,
# the walker cockpit walks around the owner's address and uploads through the
# real tracking API, so start/finish pass the 150 m geofence on a laptop.
# Refused in production builds. Real devices: leave empty.
NEXT_PUBLIC_GPS_SIM="true"

# Observability (optional). Sentry is a no-op when the DSN is empty.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time (e.g. on Vercel):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
LOG_LEVEL="info"          # debug | info | warn | error
LOG_QUERIES="false"       # true = log every Prisma query (dev only)

# Integrations (placeholders — filled in by later milestones)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
LLM_API_KEY=""
# Login codes: WhatsApp Cloud API first, Twilio SMS as fallback. In development
# without either, codes are printed to the server log.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="firuwalk_login"   # approved AUTHENTICATION template with copy-code button
WHATSAPP_OTP_LANGUAGE="es"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Notifications (Milestone 6). The same WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID
# send the event templates listed in docs/WHATSAPP_TEMPLATES.md (each must be
# approved in WhatsApp Manager, in es and en). Without them, development logs
# WhatsApp messages to the server console instead.
# Web push: generate a key pair once with `bunx web-push generate-vapid-keys`.
# Empty = push notifications unavailable.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@firuwalk.com"

# Payments (bank QR). Status changes ONLY via a verified provider webhook
# (POST /api/payments/webhook/<provider>), a provider status poll, or an
# audited admin confirmation.
#   mock   — fake bank for development/tests (default; refused in production).
#            The payment dialog shows a "Simular pago" button.
#   bankqr — adapter skeleton for the real provider (to be implemented).
PAYMENT_PROVIDER="mock"
PAYMENT_API_URL=""
PAYMENT_API_KEY=""
# Webhook signature secret (≥16 chars). Required with a real provider.
PAYMENT_WEBHOOK_SECRET=""

# Scheduled jobs: /api/cron/daily (reconciliation + plan expiry) and
# /api/cron/payouts (weekly payout batch) require `Authorization: Bearer
# $CRON_SECRET`. Vercel Cron sends it automatically. Empty = jobs disabled.
CRON_SECRET=""

# The seed WIPES the database. In production it only runs with ALLOW_SEED=true.
ALLOW_SEED="false"

# API tests (`bun run test:api`) — a DISPOSABLE database; it is wiped and reseeded.
TEST_DATABASE_URL="postgresql://firu:firu@localhost:5432/firuwalk_test?schema=public"
